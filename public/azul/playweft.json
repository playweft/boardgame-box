{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/azul/",
  "version": "1.0.0",
  "protocol": { "min": 1, "max": 1 },
  "start_url": "./index.html",
  "help_url": "./help.html",
  "name": "Azul",
  "name_localized": { "zh-CN": "花砖物语" },
  "description": "Draft colorful tiles and build a scoring wall. Classic Azul for 2–4 players.",
  "description_localized": { "zh-CN": "2–4 人选砖铺墙游戏。收集同色花砖、连接墙面得分，支持本地轮流和在线房间。" },
  "categories": ["games", "strategy", "abstract"],
  "icons": [{ "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }],
  "background_color": "#f5f1e7",
  "theme_color": "#254f76",
  "orientation": "any",
  "modes": {
    "room": {
      "players": { "min": 2, "max": 4 },
      "server": { "runtime": "lua", "entry": "./game.lua", "persistence": "durable" }
    }
  }
}
