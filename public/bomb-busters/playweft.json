{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/bomb-busters/",
  "version": "1.0.4",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./index.html",
  "help_url": "./help.html",
  "name": "Bomb Busters",
  "name_localized": {
    "zh-CN": "炸弹克星"
  },
  "description": "A cooperative wire-cutting deduction game for 2–5 players.",
  "description_localized": {
    "zh-CN": "2–5 人合作剪线推理游戏。"
  },
  "categories": [
    "games",
    "cooperative"
  ],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#6ba4ad",
  "theme_color": "#6ba4ad",
  "orientation": "any",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 5
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
